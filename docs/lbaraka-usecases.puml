CITOYEN --> UC_GET_PDF

' ══════════════════════════════════════════
'  RELATIONS — PARTENAIRE
' ══════════════════════════════════════════

PARTENAIRE --|> CITOYEN
PARTENAIRE --> UC_CREATE_FOOD_RESCUE
PARTENAIRE --> UC_NOTIF_FOOD_RESCUE

' ══════════════════════════════════════════
'  RELATIONS — ADMIN
' ══════════════════════════════════════════

ADMIN --> UC_STATS
ADMIN --> UC_ADMIN_USERS
ADMIN --> UC_ADMIN_USER_DETAIL
ADMIN --> UC_ADMIN_UPDATE_PROFIL
ADMIN --> UC_ADMIN_ROLE
ADMIN --> UC_ADMIN_BLOCK
ADMIN --> UC_ADMIN_DELETE_USER
ADMIN --> UC_ADMIN_TRANSACTIONS
ADMIN --> UC_ADMIN_TX_DETAIL
ADMIN --> UC_ADMIN_ANNONCES
ADMIN --> UC_ADMIN_DELETE_ANNONCE
ADMIN --> UC_ADMIN_RELAIS
ADMIN --> UC_CREATE_RELAIS
ADMIN --> UC_UPDATE_RELAIS
ADMIN --> UC_DELETE_RELAIS

' ══════════════════════════════════════════
'  RELATIONS — SYSTÈME CRON
' ══════════════════════════════════════════

SYSTEM --> UC_CRON_EXPIRE
SYSTEM --> UC_CRON_CONTRAT
SYSTEM --> UC_CRON_BADGES
SYSTEM --> UC_CRON_PALIER
SYSTEM --> UC_CRON_BLOCAGE
SYSTEM --> UC_CRON_DEBLOCAGE
